# ==============================================================================
# InterviewAI Environment Configuration
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Primary Provider: OpenRouter (Supports Gemini, Claude, Llama 3, GPT-4o)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Alternative: Direct Google AI Studio Gemini API
# AI_API_KEY=your_gemini_api_key_here
# AI_MODEL=gemini-1.5-flash

# Optional: PostgreSQL Database (For persistent storage beyond localStorage)
# DATABASE_URL="postgresql://user:password@localhost:5432/interviewai"
